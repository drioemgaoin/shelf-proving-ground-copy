{
  "extends": "stylelint-config-standard",
  "plugins": ["./scripts/stylelint/shelf-rules.mjs"],
  "rules": {
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["layer"] }],
    "custom-property-pattern": null,
    "custom-property-empty-line-before": null,
    "comment-empty-line-before": null,
    "no-duplicate-selectors": null,
    "hue-degree-notation": null,
    "alpha-value-notation": null,
    "color-hex-length": null,
    "value-keyword-case": null,
    "shelf/keyframes-in-layer": true,
    "shelf/animation-properties": true,
    "shelf/transition-properties": true,
    "shelf/motion-token-values": true
  }
}
