{
  "name": "shelf",
  "version": "1.0.0",
  "description": "Everything needed to specify, build, review and fix UI with agents, with no visual surprises. Copy the contents into a repo root.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:scripts": "node scripts/run-qa-scripts.mjs",
    "test:app": "npm run check && npm run test && npm run test:scripts && npm run e2e",
    "qa": "playwright test --config qa/playwright.config.ts",
    "qa:judge": "node qa/ticket-flow/acceptance/pipeline-judge.mjs",
    "test:qa": "npm run qa && npm run qa:judge",
    "ui:qa": "node scripts/ui-qa/run.mjs",
    "sandcastle": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/main.mts",
    "sandcastle:single": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/main.mts --single",
    "sandcastle:resume": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/main.mts --single --resume",
    "sandcastle:tickets": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/main.mts --tickets",
    "sandcastle:reset": "npx tsx .sandcastle/scripts/reset.mts",
    "sandcastle:bench": "npx tsx .sandcastle/bench/bench.mts",
    "sandcastle:implement": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay/replay.mts",
    "sandcastle:visual-qa": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay/replay-visual-qa.mts",
    "sandcastle:review": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay/replay-review.mts",
    "sandcastle:fix": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay/replay-fix.mts",
    "eval:t1": "node qa/hooks/runner.mjs --save",
    "eval:t1:check": "node qa/hooks/runner.mjs",
    "eval:t1:verbose": "node qa/hooks/runner.mjs --verbose",
    "eval:t1:escapes": "node qa/hooks/runner.mjs --tag escape",
    "eval:t1:rule": "node qa/hooks/runner.mjs --rule",
    "eval:t1:tag": "node qa/hooks/runner.mjs --tag",
    "eval:t1:history": "node qa/hooks/runner.mjs --history",
    "eval:prompt": "node qa/prompt-evals/runner.mjs --prompt",
    "eval:prompt:save": "node qa/prompt-evals/runner.mjs --save --prompt",
    "eval:prompt:verbose": "node qa/prompt-evals/runner.mjs --verbose --prompt",
    "eval:prompt:rule": "node qa/prompt-evals/runner.mjs --rule",
    "audit:rules": "node scripts/audit-rules.mjs",
    "monitor:report": "node scripts/monitor/report.mjs",
    "monitor:report:html": "node scripts/monitor/report.mjs --html",
    "review": "node scripts/review.mjs",
    "sandcastle:watch": "bash .sandcastle/scripts/watch.sh",
    "postinstall": "playwright install --with-deps 2>/dev/null || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@axe-core/playwright": "^4.13.0",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss-custom-media": "^12.0.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
