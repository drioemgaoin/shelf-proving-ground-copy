{
  "name": "shelf",
  "version": "1.0.0",
  "description": "Everything needed to specify, build, review and fix UI with agents, with no visual surprises. Copy the contents into a repo root.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "ui:qa": "node scripts/ui-qa/run.mjs",
    "sandcastle": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/main.mts",
    "sandcastle:single": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/main.mts --single",
    "sandcastle:tickets": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/main.mts --tickets",
    "sandcastle:reset": "npx tsx .sandcastle/reset.mts",
    "sandcastle:bench": "npx tsx .sandcastle/bench.mts",
    "sandcastle:implement": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay.mts",
    "sandcastle:visual-qa": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay-visual-qa.mts",
    "sandcastle:review": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay-review.mts",
    "sandcastle:fix": "[ -d node_modules/@ai-hero/sandcastle ] || npm install && npx tsx .sandcastle/replay-fix.mts",
    "audit:rules": "node scripts/audit-rules.mjs",
    "review": "node scripts/review.mjs",
    "sandcastle:watch": "bash .sandcastle/watch.sh",
    "postinstall": "playwright install --with-deps 2>/dev/null || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
